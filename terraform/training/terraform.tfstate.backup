      "instances": [
        {
          "index_key": "angular-app",
          "schema_version": 0,
          "attributes": {
            "folder": "",
            "id": "/job/angular-app",
            "name": "angular-app",
            "template": "\u003c?xml version=\"1.1\" encoding=\"UTF-8\"?\u003e\n\u003cflow-definition plugin=\"workflow-job@1595.v0ee1a_de2c0a_3\"\u003e\n  \u003cactions/\u003e\n  \u003cdescription\u003eTerraform-managed angular pipeline for earn-angular-app\u003c/description\u003e\n  \u003ckeepDependencies\u003efalse\u003c/keepDependencies\u003e\n  \u003cproperties/\u003e\n  \u003cdefinition class=\"org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition\" plugin=\"workflow-cps@4370.v49a_6937566b_6\"\u003e\n    \u003cscript\u003epipeline {\n\n    agent any\n\n\n    environment {\n        IMAGE_NAME      = \u0026quot;192.168.238.50:5000/demo-angular-app\u0026quot;\n        CONTAINER_NAME  = \u0026quot;demo-angular-app\u0026quot;\n        CONTAINER_PORT  = \u0026quot;80\u0026quot;\n        HOST_PORT       = \u0026quot;4600\u0026quot;\n    }\n\n    stages {\n\n        stage(\u0026apos;Checkout\u0026apos;) {\n            steps {\n                git branch: \u0026quot;main\u0026quot;,\n                    credentialsId: \u0026quot;github-jenkins-pat\u0026quot;,\n                    url: \u0026quot;https://github.com/jafarulla15/DevOps-Demo-Angular.git\u0026quot;\n            }\n        }\n\n        stage(\u0026apos;Install Dependencies\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    npm ci\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Build Angular\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    npm run build\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Docker Build\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker build \\\n                      -t $IMAGE_NAME:$BUILD_NUMBER \\\n                      -t $IMAGE_NAME:latest .\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Stop Existing Container\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker rm -f $CONTAINER_NAME || true\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Run Angular\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker run -d \\\n                      --name $CONTAINER_NAME \\\n                      --network monitoring \\\n                      -p $HOST_PORT:$CONTAINER_PORT \\\n                      $IMAGE_NAME:latest\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n    }\n\n    post {\n\n        success {\n            echo \u0026apos;======================================\u0026apos;\n            echo \u0026apos;earn-angular-app deployment successful\u0026apos;\n            echo \u0026apos;======================================\u0026apos;\n        }\n\n        failure {\n            echo \u0026apos;earn-angular-app pipeline failed\u0026apos;\n        }\n\n        always {\n            cleanWs()\n        }\n    }\n}\n\u003c/script\u003e\n    \u003csandbox\u003etrue\u003c/sandbox\u003e\n  \u003c/definition\u003e\n  \u003ctriggers/\u003e\n  \u003cdisabled\u003efalse\u003c/disabled\u003e\n\u003c/flow-definition\u003e"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
          "dependencies": [
            "docker_network.monitoring",
            "module.docker.null_resource.docker_install",
            "module.jenkins.docker_container.jenkins",
            "module.jenkins.docker_image.jenkins",
            "module.jenkins.docker_volume.jenkins_home"
          ]
        },
        {
          "index_key": "dotnet-api",
          "schema_version": 0,
          "attributes": {
            "folder": "",
            "id": "/job/dotnet-api",
            "name": "dotnet-api",
            "template": "\u003c?xml version=\"1.1\" encoding=\"UTF-8\"?\u003e\n\u003cflow-definition plugin=\"workflow-job@1595.v0ee1a_de2c0a_3\"\u003e\n  \u003cactions/\u003e\n  \u003cdescription\u003eTerraform-managed dotnet pipeline for earn-dotnet-api\u003c/description\u003e\n  \u003ckeepDependencies\u003efalse\u003c/keepDependencies\u003e\n  \u003cproperties/\u003e\n  \u003cdefinition class=\"org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition\" plugin=\"workflow-cps@4370.v49a_6937566b_6\"\u003e\n    \u003cscript\u003epipeline {\n\n    agent any\n\n\n    environment {\n        IMAGE_NAME      = \u0026quot;192.168.238.50:5000/demo-dotnet-api\u0026quot;\n        CONTAINER_NAME  = \u0026quot;demo-dotnet-api\u0026quot;\n        CONTAINER_PORT  = \u0026quot;8080\u0026quot;\n        HOST_PORT       = \u0026quot;5000\u0026quot;\n    }\n\n    stages {\n\n        stage(\u0026apos;Checkout\u0026apos;) {\n            steps {\n                git branch: \u0026quot;main\u0026quot;,\n                    credentialsId: \u0026quot;github-jenkins-pat\u0026quot;,\n                    url: \u0026quot;https://github.com/jafarulla15/DevOps-Demo-REST-Api.git\u0026quot;\n            }\n        }\n\n        stage(\u0026apos;Restore\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    dotnet restore\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Build\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    dotnet build --configuration Release --no-restore\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Test\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    dotnet test --configuration Release --no-build\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Docker Build\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker build \\\n                      -t $IMAGE_NAME:$BUILD_NUMBER \\\n                      -t $IMAGE_NAME:latest .\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Stop Existing Container\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker rm -f $CONTAINER_NAME || true\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Run Application\u0026apos;) {\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker run -d \\\n                      --name $CONTAINER_NAME \\\n                      --network monitoring \\\n                      -p $HOST_PORT:$CONTAINER_PORT \\\n                      $IMAGE_NAME:latest\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n    }\n\n    post {\n\n        success {\n            echo \u0026apos;======================================\u0026apos;\n            echo \u0026apos;earn-dotnet-api deployment successful\u0026apos;\n            echo \u0026apos;======================================\u0026apos;\n        }\n\n        failure {\n            echo \u0026apos;earn-dotnet-api pipeline failed\u0026apos;\n        }\n\n        always {\n            cleanWs()\n        }\n    }\n}\n\u003c/script\u003e\n    \u003csandbox\u003etrue\u003c/sandbox\u003e\n  \u003c/definition\u003e\n  \u003ctriggers/\u003e\n  \u003cdisabled\u003efalse\u003c/disabled\u003e\n\u003c/flow-definition\u003e"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
