      "instances": [
        {
          "index_key": "angular-app",
          "schema_version": 0,
          "attributes": {
            "folder": "",
            "id": "/job/angular-app",
            "name": "angular-app",
            "template": "\u003c?xml version=\"1.1\" encoding=\"UTF-8\"?\u003e\n\u003cflow-definition plugin=\"workflow-job@1595.v0ee1a_de2c0a_3\"\u003e\n  \u003cactions/\u003e\n  \u003cdescription\u003eTerraform-managed pipeline for earn-angular-app\u003c/description\u003e\n  \u003ckeepDependencies\u003efalse\u003c/keepDependencies\u003e\n  \u003cproperties/\u003e\n  \u003cdefinition class=\"org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition\" plugin=\"workflow-cps@4370.v49a_6937566b_6\"\u003e\n    \u003cscript\u003epipeline {\n\n    agent any\n\n    triggers {\n        cron(\u0026apos;H/10 * * * *\u0026apos;)\n    }\n\n    environment {\n        IMAGE_NAME      = \u0026quot;192.168.238.50:5000/demo-angular-app\u0026quot;\n        CONTAINER_NAME  = \u0026quot;demo-angular-app\u0026quot;\n        CONTAINER_PORT  = \u0026quot;80\u0026quot;\n        HOST_PORT       = \u0026quot;4600\u0026quot;\n        DEPLOY_STATE_FILE = \u0026quot;/var/jenkins_home/pipeline-state/demo-angular-app.sha\u0026quot;\n    }\n\n    stages {\n\n        stage(\u0026apos;Checkout\u0026apos;) {\n            steps {\n                git branch: \u0026quot;main\u0026quot;,\n                    credentialsId: \u0026quot;github-jenkins-pat\u0026quot;,\n                    url: \u0026quot;https://github.com/jafarulla15/DevOps-Demo-Angular.git\u0026quot;\n            }\n        }\n\n        stage(\u0026apos;Check Deploy Trigger\u0026apos;) {\n            steps {\n                script {\n                    def latestCommit = sh(script: \u0026apos;git log -1 --pretty=%H\u0026apos;, returnStdout: true).trim()\n                    def commitMessage = sh(script: \u0026apos;git log -1 --pretty=%B\u0026apos;, returnStdout: true).trim()\n\n                    sh \u0026apos;mkdir -p /var/jenkins_home/pipeline-state\u0026apos;\n                    def previousCommit = fileExists(env.DEPLOY_STATE_FILE) ? readFile(env.DEPLOY_STATE_FILE).trim() : \u0026apos;\u0026apos;\n\n                    def isNewCommit = (latestCommit != previousCommit)\n                    def hasTriggerPhrase = commitMessage.toLowerCase().contains(\u0026apos;deploy it now\u0026apos;)\n\n                    env.LATEST_COMMIT = latestCommit\n                    env.SHOULD_DEPLOY = (isNewCommit \u0026amp;\u0026amp; hasTriggerPhrase) ? \u0026apos;true\u0026apos; : \u0026apos;false\u0026apos;\n\n                    echo \u0026quot;Latest commit: ${latestCommit}\u0026quot;\n                    echo \u0026quot;Commit message: ${commitMessage}\u0026quot;\n                    echo \u0026quot;New commit since last check: ${isNewCommit}\u0026quot;\n                    echo \u0026quot;Contains deploy trigger phrase (\u0026apos;deploy it now\u0026apos;): ${hasTriggerPhrase}\u0026quot;\n                    echo \u0026quot;Will deploy: ${env.SHOULD_DEPLOY}\u0026quot;\n                }\n            }\n        }\n\n        stage(\u0026apos;Docker Build\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker build \\\n                      -t $IMAGE_NAME:$BUILD_NUMBER \\\n                      -t $IMAGE_NAME:latest .\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Stop Existing Container\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker rm -f $CONTAINER_NAME || true\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Run Application\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker run -d \\\n                      --name $CONTAINER_NAME \\\n                      --network monitoring \\\n                      -p $HOST_PORT:$CONTAINER_PORT \\\n                      $IMAGE_NAME:latest\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Record Deployed Commit\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                writeFile file: env.DEPLOY_STATE_FILE, text: env.LATEST_COMMIT\n            }\n        }\n    }\n\n    post {\n\n        success {\n            echo \u0026apos;======================================\u0026apos;\n            echo \u0026apos;earn-angular-app deployment successful\u0026apos;\n            echo \u0026apos;======================================\u0026apos;\n        }\n\n        failure {\n            echo \u0026apos;earn-angular-app pipeline failed\u0026apos;\n        }\n\n        always {\n            cleanWs()\n        }\n    }\n}\n\u003c/script\u003e\n    \u003csandbox\u003etrue\u003c/sandbox\u003e\n  \u003c/definition\u003e\n  \u003ctriggers/\u003e\n  \u003cdisabled\u003efalse\u003c/disabled\u003e\n\u003c/flow-definition\u003e"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
          "dependencies": [
            "docker_network.monitoring",
            "module.docker.null_resource.docker_install",
            "module.jenkins.docker_container.jenkins",
            "module.jenkins.docker_image.jenkins",
            "module.jenkins.docker_volume.jenkins_home"
          ]
        },
        {
          "index_key": "dotnet-api",
          "schema_version": 0,
          "attributes": {
            "folder": "",
            "id": "/job/dotnet-api",
            "name": "dotnet-api",
            "template": "\u003c?xml version=\"1.1\" encoding=\"UTF-8\"?\u003e\n\u003cflow-definition plugin=\"workflow-job@1595.v0ee1a_de2c0a_3\"\u003e\n  \u003cactions/\u003e\n  \u003cdescription\u003eTerraform-managed pipeline for earn-dotnet-api\u003c/description\u003e\n  \u003ckeepDependencies\u003efalse\u003c/keepDependencies\u003e\n  \u003cproperties/\u003e\n  \u003cdefinition class=\"org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition\" plugin=\"workflow-cps@4370.v49a_6937566b_6\"\u003e\n    \u003cscript\u003epipeline {\n\n    agent any\n\n    triggers {\n        cron(\u0026apos;H/10 * * * *\u0026apos;)\n    }\n\n    environment {\n        IMAGE_NAME      = \u0026quot;192.168.238.50:5000/demo-dotnet-api\u0026quot;\n        CONTAINER_NAME  = \u0026quot;demo-dotnet-api\u0026quot;\n        CONTAINER_PORT  = \u0026quot;8070\u0026quot;\n        HOST_PORT       = \u0026quot;5000\u0026quot;\n        DEPLOY_STATE_FILE = \u0026quot;/var/jenkins_home/pipeline-state/demo-dotnet-api.sha\u0026quot;\n    }\n\n    stages {\n\n        stage(\u0026apos;Checkout\u0026apos;) {\n            steps {\n                git branch: \u0026quot;main\u0026quot;,\n                    credentialsId: \u0026quot;github-jenkins-pat\u0026quot;,\n                    url: \u0026quot;https://github.com/jafarulla15/DevOps-Demo-REST-Api.git\u0026quot;\n            }\n        }\n\n        stage(\u0026apos;Check Deploy Trigger\u0026apos;) {\n            steps {\n                script {\n                    def latestCommit = sh(script: \u0026apos;git log -1 --pretty=%H\u0026apos;, returnStdout: true).trim()\n                    def commitMessage = sh(script: \u0026apos;git log -1 --pretty=%B\u0026apos;, returnStdout: true).trim()\n\n                    sh \u0026apos;mkdir -p /var/jenkins_home/pipeline-state\u0026apos;\n                    def previousCommit = fileExists(env.DEPLOY_STATE_FILE) ? readFile(env.DEPLOY_STATE_FILE).trim() : \u0026apos;\u0026apos;\n\n                    def isNewCommit = (latestCommit != previousCommit)\n                    def hasTriggerPhrase = commitMessage.toLowerCase().contains(\u0026apos;deploy it now\u0026apos;)\n\n                    env.LATEST_COMMIT = latestCommit\n                    env.SHOULD_DEPLOY = (isNewCommit \u0026amp;\u0026amp; hasTriggerPhrase) ? \u0026apos;true\u0026apos; : \u0026apos;false\u0026apos;\n\n                    echo \u0026quot;Latest commit: ${latestCommit}\u0026quot;\n                    echo \u0026quot;Commit message: ${commitMessage}\u0026quot;\n                    echo \u0026quot;New commit since last check: ${isNewCommit}\u0026quot;\n                    echo \u0026quot;Contains deploy trigger phrase (\u0026apos;deploy it now\u0026apos;): ${hasTriggerPhrase}\u0026quot;\n                    echo \u0026quot;Will deploy: ${env.SHOULD_DEPLOY}\u0026quot;\n                }\n            }\n        }\n\n        stage(\u0026apos;Docker Build\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker build \\\n                      -t $IMAGE_NAME:$BUILD_NUMBER \\\n                      -t $IMAGE_NAME:latest .\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Stop Existing Container\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker rm -f $CONTAINER_NAME || true\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Run Application\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                sh \u0026apos;\u0026apos;\u0026apos;\n                    docker run -d \\\n                      --name $CONTAINER_NAME \\\n                      --network monitoring \\\n                      -p $HOST_PORT:$CONTAINER_PORT \\\n                      $IMAGE_NAME:latest\n                \u0026apos;\u0026apos;\u0026apos;\n            }\n        }\n\n        stage(\u0026apos;Record Deployed Commit\u0026apos;) {\n            when {\n                environment name: \u0026apos;SHOULD_DEPLOY\u0026apos;, value: \u0026apos;true\u0026apos;\n            }\n            steps {\n                writeFile file: env.DEPLOY_STATE_FILE, text: env.LATEST_COMMIT\n            }\n        }\n    }\n\n    post {\n\n        success {\n            echo \u0026apos;======================================\u0026apos;\n            echo \u0026apos;earn-dotnet-api deployment successful\u0026apos;\n            echo \u0026apos;======================================\u0026apos;\n        }\n\n        failure {\n            echo \u0026apos;earn-dotnet-api pipeline failed\u0026apos;\n        }\n\n        always {\n            cleanWs()\n        }\n    }\n}\n\u003c/script\u003e\n    \u003csandbox\u003etrue\u003c/sandbox\u003e\n  \u003c/definition\u003e\n  \u003ctriggers/\u003e\n  \u003cdisabled\u003efalse\u003c/disabled\u003e\n\u003c/flow-definition\u003e"
